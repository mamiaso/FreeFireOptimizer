<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FreeFireOptimizer.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BackgroundColor">#0F172A</Color>
            <Color x:Key="CardColor">#172338</Color>
            <Color x:Key="NeonBlue">#00F2FE</Color>
            <Color x:Key="TextColor">#F8FAFC</Color>
            <Color x:Key="MutedColor">#94A3B8</Color>
            <Color x:Key="BorderColor">#29405C</Color>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource MutedColor}" />
                <Setter Property="BackgroundColor" Value="#202F46" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="BackgroundColor" Value="#202F46" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
